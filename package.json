{
  "name": "pi-lightpanda",
  "version": "0.1.0",
  "description": "Lightweight headless browser for the Pi agent via Lightpanda (CDP-compatible, ~16x less memory than Chrome)",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "browser",
    "lightpanda",
    "headless",
    "cdp",
    "automation",
    "scraping"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonyputi/pi-lightpanda.git"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "setup.ts",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.6.5",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "node test.ts"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      "@semantic-release/git"
    ]
  },
  "dependencies": {
    "puppeteer-core": "^25.0.0",
    "typebox": "^1.3.27"
  }
}
