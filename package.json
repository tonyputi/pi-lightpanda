{
  "name": "pi-lightpanda",
  "version": "0.3.0",
  "description": "Lightweight, CDP-compatible browser tools for the Pi agent via Lightpanda, without Chromium",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "browser",
    "lightpanda",
    "headless",
    "cdp",
    "automation",
    "scraping"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonyputi/pi-lightpanda.git"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "browser.ts",
    "setup.ts",
    "extract.ts",
    "README.md",
    "docs/",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@types/node": "^22.20.5",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "check": "npm run typecheck && npm test && npm run test:package",
    "typecheck": "tsc --noEmit",
    "test": "node --test *.test.ts",
    "test:coverage": "node --experimental-test-coverage --test --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=85 --test-coverage-include=index.ts --test-coverage-include=browser.ts --test-coverage-include=setup.ts --test-coverage-include=extract.ts *.test.ts",
    "test:package": "node --test package-check.ts",
    "test:smoke": "node smoke.ts"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "dependencies": {
    "puppeteer-core": "^25.0.0"
  }
}
